{
  "hooks": {
    "SessionStart":     [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "SessionStart"], "timeout": 10, "async": true } ] } ],
    "UserPromptSubmit": [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "UserPromptSubmit"], "timeout": 10 } ] } ],
    "PreToolUse":       [ { "matcher": "*", "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "PreToolUse"], "timeout": 10 } ] } ],
    "Stop":             [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "Stop"], "timeout": 10 } ] } ],
    "StopFailure":      [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "StopFailure"], "timeout": 10 } ] } ],
    "PostCompact":      [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "PostCompact"], "timeout": 10 } ] } ],
    "PostModelSwitch":  [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "PostModelSwitch"], "timeout": 10 } ] } ],
    "SessionEnd":       [ { "hooks": [ { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/cc-cache-warming-hook.sh", "SessionEnd"], "timeout": 5 } ] } ]
  }
}
